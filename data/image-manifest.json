    "awaiting-user-image": "Prompt delivered; waiting for the owner's ChatGPT Images output",
    "needs-generation": "Prompt written; not yet requested",
    "ready-for-review": "Processed into AVIF/WebP; needs visual approval before use",
    "implemented": "Approved and rendered on the site",
    "interim": "Rendered now from existing approved artwork; replace when final asset exists",
    "blocked": "Cannot be produced honestly until a product fact is confirmed"
  },
