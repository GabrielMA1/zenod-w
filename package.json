{
  "name": "zeno-detail-storefront",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local production storefront for ZENO DETAIL.",
  "scripts": {
    "generate": "node scripts/generate-pages.mjs",
    "predev": "npm run generate",
    "dev": "vite --configLoader runner",
    "prebuild": "npm run generate",
    "build": "vite build --configLoader runner",
    "preview": "vite preview --configLoader runner",
    "audit": "node scripts/audit.mjs",
    "audit:dist": "node scripts/audit-dist.mjs",
    "qa": "npm run build && npm run audit && npm run audit:dist"
  },
  "devDependencies": {
    "vite": "^7.1.3"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0"
  }
}
